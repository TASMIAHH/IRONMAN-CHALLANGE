    <LegacyWindowsSdkDir>$(MSBuildProgramFiles32)\Microsoft SDKs\Windows\v7.1A</LegacyWindowsSdkDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WindowsSDK_IncludePath)'=='' And Exists('$(LegacyWindowsSdkDir)\Include')">
    <IncludePath>$(VC_IncludePath);$(LegacyWindowsSdkDir)\Include;$(IncludePath)</IncludePath>
    <LibraryPath>$(VC_LibraryPath);$(LegacyWindowsSdkDir)\Lib;$(LibraryPath)</LibraryPath>
    <ExecutablePath>$(VC_ExecutablePath_x86);$(LegacyWindowsSdkDir)\Bin;$(ExecutablePath)</ExecutablePath>
  </PropertyGroup>
